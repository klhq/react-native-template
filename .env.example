# Copy to .env and fill in real values. Vars prefixed EXPO_PUBLIC_ are inlined
# into the JS bundle at build time (readable by anyone) — never put secrets here.
# See https://docs.expo.dev/guides/environment-variables/

EXPO_PUBLIC_API_URL=https://api.example.com

# Switches app.config.js between dev/prod bundle id + app name.
# APP_ENV=development
